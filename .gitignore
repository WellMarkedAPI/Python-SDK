# The repo-root .gitignore ignores tests/ globally (legacy rule for
# api/website). The SDK's tests/ directory ships in the sdist, so
# negate that here.
!tests/

__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IntelliJ internal files/directories
*.iml
*.idea/